# WhatsApp de la vinoteca para el botón "Lo quiero" (solo números, con código de país, sin +)
# Ejemplo: 5493772123456
VITE_WHATSAPP_NUMBER=549XXXXXXXXXX

# Conexión con Nexus (si faltan, la app funciona en modo demo con datos en el dispositivo)
# URL de la API de Nexus CON el prefijo /api, sin "/" al final. Si cambia el dominio, actualizar connect-src en vercel.json
# Local: http://localhost:3001/api
VITE_NEXUS_API_URL=https://api-nexus.atomsolucionesit.com.ar/api
# (Opcional) Socket.io: por defecto es VITE_NEXUS_API_URL sin /api
VITE_NEXUS_SOCKET_URL=
# Slug del catálogo público que la vinoteca armó en Nexus para el club (Productos → Catálogo público)
VITE_NEXUS_CATALOG_SLUG=

# Ingreso con Google (Firebase). MISMO proyecto que FIREBASE_PROJECT_ID de atom-crm-api
# (copiar de atom-crm-front/.env). Sin estas variables no se muestra el botón de Google.
# En Firebase Console: Authentication → Sign-in method → Google habilitado, y el dominio de
# la app (ej. club.vercel.app) en Authentication → Settings → Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
